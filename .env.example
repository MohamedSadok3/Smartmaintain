# ============================================================
#  SmartMaintain — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
POSTGRES_DB=smartmaintain
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_URL=postgresql://admin:replace-with-a-strong-random-password@postgres:5432/smartmaintain

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MQTT broker ─────────────────────────────────────────────
MQTT_BROKER=mosquitto

# ── Security ────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-secret
SUPERADMIN_EMAIL=superadmin@smartmaintain.local
SUPERADMIN_PASSWORD=replace-with-at-least-12-random-characters

# ── ML engine ───────────────────────────────────────────────
# The ML service loads the trained models automatically.

# ── IoT service ─────────────────────────────────────────────
# Set IOT_PLANT_ID to the database ID of the plant whose sensors this IoT
# service is collecting data for.  This value is stamped on every Redis
# message so the Alertes service creates alerts under the correct plant
# without falling back to "first plant in the database".
# IOT_PLANT_ID=1

# ── Frontend base URL (used in email links) ─────────────────
APP_BASE_URL=http://localhost:3000

# ── Email provider ──────────────────────────────────────────
# Choose: "smtp" (Gmail / any SMTP) or "resend" (Resend.com API)
MAIL_PROVIDER=smtp
MAIL_FROM_EMAIL=SmartMaintain <your-email@gmail.com>

# SMTP settings (used when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password-here

# Resend settings (used when MAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
